# EditorConfig — https://editorconfig.org
# Top-most EditorConfig file for the Weather4Agents solution.
root = true

##########################################
# All files
##########################################
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

##########################################
# Markup / data / config files
##########################################
[*.{json,yml,yaml,csproj,props,targets,xml,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

##########################################
# C# files
##########################################
[*.cs]
indent_size = 4
max_line_length = 120

# --- Language conventions ------------------------------------------------
# 'this.' is not required.
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Prefer language keywords over BCL type names (int over Int32).
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# Modern C# idioms.
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion
dotnet_style_prefer_conditional_expression_over_return = true:suggestion
dotnet_style_readonly_field = true:suggestion

# --- 'var' preferences ---------------------------------------------------
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# --- Expression-bodied members ------------------------------------------
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion

# --- Modern language features -------------------------------------------
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_prefer_top_level_statements = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_inlined_variable_declaration = true:suggestion
csharp_style_prefer_primary_constructors = false:silent

# --- using directives ----------------------------------------------------
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# --- Braces / new lines --------------------------------------------------
csharp_prefer_braces = true:silent
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# --- Naming rules --------------------------------------------------------
# Interfaces are PascalCase prefixed with 'I'.
dotnet_naming_rule.interfaces_start_with_i.severity = suggestion
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_start_with_i.style = prefix_interface_with_i
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.prefix_interface_with_i.capitalization = pascal_case
dotnet_naming_style.prefix_interface_with_i.required_prefix = I

# Types and public members are PascalCase.
dotnet_naming_rule.types_are_pascal_case.severity = suggestion
dotnet_naming_rule.types_are_pascal_case.symbols = type_and_member_symbols
dotnet_naming_rule.types_are_pascal_case.style = pascal_case_style
dotnet_naming_symbols.type_and_member_symbols.applicable_kinds = class,struct,enum,property,method,event,namespace
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# Rules are matched top-to-bottom, first match wins — so the more specific field kinds
# (const, then static) are declared before the general private-instance-field rule.

# Constants are PascalCase.
dotnet_naming_rule.constants_pascal_case.severity = suggestion
dotnet_naming_rule.constants_pascal_case.symbols = constant_symbol
dotnet_naming_rule.constants_pascal_case.style = pascal_case_style
dotnet_naming_symbols.constant_symbol.applicable_kinds = field
dotnet_naming_symbols.constant_symbol.required_modifiers = const

# Static fields (incl. static readonly) are PascalCase.
dotnet_naming_rule.static_fields_pascal_case.severity = suggestion
dotnet_naming_rule.static_fields_pascal_case.symbols = static_field_symbol
dotnet_naming_rule.static_fields_pascal_case.style = pascal_case_style
dotnet_naming_symbols.static_field_symbol.applicable_kinds = field
dotnet_naming_symbols.static_field_symbol.required_modifiers = static

# Private instance fields are _camelCase (protected/internal fields are left to PascalCase).
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbol
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_symbols.private_field_symbol.applicable_kinds = field
dotnet_naming_symbols.private_field_symbol.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

##########################################
# Infrastructure — scoped, documented suppressions (active everywhere else)
##########################################
[Weather4Agents.Infrastructure/**.cs]
# The 'protected readonly' fields on BaseWeatherScraper are the intended inheritance seam.
dotnet_diagnostic.CA1051.severity = none
# The codebase consistently names cancellation tokens 'ct' rather than the base 'stoppingToken'.
dotnet_diagnostic.CA1725.severity = none

##########################################
# Test project — relax analyzer rules that fight test conventions
##########################################
[Weather4Agents.Test/**.cs]
# Test method names use the Method_Scenario_Expectation convention (underscores).
dotnet_diagnostic.CA1707.severity = none
# Test helpers favour readability over micro-optimisations flagged by these rules.
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1869.severity = none
