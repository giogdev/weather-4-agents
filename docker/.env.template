# WeatherScraping settings
WeatherScraping__DefaultProvider=3bMeteo
WeatherScraping__EnabledProviders__0=3bMeteo
WeatherScraping__Locations__0=Bergamo
WeatherScraping__JobIntervalMinutes=60
WeatherScraping__TodayCacheMinutes=30
WeatherScraping__ExtendedCacheHours=6
WeatherScraping__NegativeCacheMinutes=5

# WeatherFileStorage settings
# (storage runs at the end of each scraping cycle; it has no separate interval)
WeatherFileStorage__Enabled=true
WeatherFileStorage__OutputPath=/app/weather-data
WeatherFileStorage__CleanupEnabled=false
