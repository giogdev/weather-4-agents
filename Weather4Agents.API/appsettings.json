{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "WeatherScraping": {
    "DefaultProvider": "3bMeteo",
    "EnabledProviders": [ "3bMeteo" ],
    "Locations": [ "Bergamo" ],
    "AllowUnconfiguredLocations": true,
    "JobIntervalMinutes": 60,
    "HttpTimeoutSeconds": 15,
    "TodayCacheMinutes": 30,
    "ExtendedCacheHours": 6,
    "NegativeCacheMinutes": 5
  },

  "WeatherFileStorage": {
    "Enabled": false,
    "OutputPath": "weather-data",
    "CleanupEnabled": false
  },

  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },

  "HealthCheck": {
    "MaxScrapeAgeMinutes": 120
  }
}
