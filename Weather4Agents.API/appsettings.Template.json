{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "WeatherScraping": {
    "DefaultProvider": "3bMeteo",
    "EnabledProviders": [ "3bMeteo" ],
    "Locations": [ "Bergamo" ],
    "AllowUnconfiguredLocations": true,
    "JobIntervalMinutes": 60,
    "HttpTimeoutSeconds": 15
  },

  "WeatherFileStorage": {
    "Enabled": false,
    "OutputPath": "weather-data",
    "JobIntervalMinutes": 60,
    "CleanupEnabled": false
  },

  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0
  }
}
